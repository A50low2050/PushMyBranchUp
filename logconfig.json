{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "standard": {
            "format": "[MAIN] %(asctime)s :: [%(levelname)s] :: %(name)s :: %(message)s",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        },
        "detailed": {
            "format": "[MAIN] %(asctime)s :: %(levelname)8s :: %(name)15s :: %(module)10s:%(lineno)3d :: %(message)s",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        }
    },
    "handlers": {
        "stdout": {
            "class": "logging.StreamHandler",
            "formatter": "standard",
            "level": "INFO",
            "stream": "ext://sys.stdout"
        },
        "file": {
            "class": "logging.handlers.RotatingFileHandler", 
            "filename": "logs/main.log",
            "formatter": "detailed",
            "level": "INFO",
            "maxBytes": 1048576,
            "backupCount": 3, 
            "mode": "a",
            "encoding": "utf-8"
        }
    },
    "root": {
        "handlers": ["stdout", "file"],
        "level": "INFO"
    }
}
